{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gym-fee-review",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-17",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gym-fee-review-events",
      "database_id": "f3f53b0b-bf74-475c-b640-22ef0a4bb81c",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 18 * * *"]
  }
}
